<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- Runs a sync with each project's configured name once the workbench is up -->
   <extension point="org.eclipse.ui.startup">
      <startup class="local.commentbreakpoints.Startup"/>
   </extension>

   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="local.commentbreakpoints.Prefs"/>
   </extension>

   <!-- Found through Quick Access (Ctrl+3) by typing "Comment Breakpoints" -->
   <extension point="org.eclipse.ui.commands">
      <command
            id="commentBreakpoints.sync"
            name="Comment Breakpoints: Set Breakpoints From Comments"
            description="Sets a breakpoint on the line after every &quot;// &lt;name&gt; breakpoint N&quot; comment.">
         <!-- Optional: when a key binding supplies it, the prompt is skipped -->
         <commandParameter id="name" name="Name" optional="true"/>
      </command>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="commentBreakpoints.sync"
            class="local.commentbreakpoints.SyncHandler"/>
   </extension>

   <!--
     Key binding that passes the name and so skips the prompt. Uncomment, change the
     key and name, then rebuild and reinstall (see README.md).

   <extension point="org.eclipse.ui.bindings">
      <key
            sequence="M1+M3+B"
            commandId="commentBreakpoints.sync"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            contextId="org.eclipse.ui.contexts.window">
         <parameter id="name" value="mike"/>
      </key>
   </extension>
   -->

   <!-- Workspace-wide settings (Window > Preferences > Comment Breakpoints) -->
   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="local.commentbreakpoints.preferences"
            name="Comment Breakpoints"
            class="local.commentbreakpoints.PreferencePage"/>
   </extension>

   <!-- Per-project settings (Project > Properties > Comment Breakpoints) -->
   <extension point="org.eclipse.ui.propertyPages">
      <page
            id="local.commentbreakpoints.properties"
            name="Comment Breakpoints"
            class="local.commentbreakpoints.PreferencePage">
         <enabledWhen>
            <adapt type="org.eclipse.core.resources.IProject"/>
         </enabledWhen>
      </page>
   </extension>

</plugin>
